# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Desktop build products and downloaded model artifacts
desktop/node_modules/
desktop/dist/
desktop/dist-resources/
desktop/resources/
.cache/
**/__pycache__/
